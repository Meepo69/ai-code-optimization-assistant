{
  "name": "ai-code-optimization-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply code-coach-db --local",
    "db:remote": "wrangler d1 migrations apply code-coach-db --remote",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check public/app.js"
  },
  "devDependencies": {"wrangler": "^4.0.0"}
}
